---
import type { Lang } from '../config/site';
import { UI, localePath } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { PHOTOS } from '../lib/photos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const items = [
  { h: t.pr1, p: t.pr1d },
  { h: t.pr2, p: t.pr2d },
  { h: t.pr3, p: t.pr3d },
  { h: t.pr4, p: t.pr4d },
];
---
<BaseLayout lang={lang} title={t.about} description={t.aboutP} alt={{ en: '/about/', ms: '/ms/about/' }} hreflang={{ en: '/about/', ms: '/ms/about/' }} darkHeader>
  <div class="ab-hero">
    <Photo src={PHOTOS.about.src} alt={PHOTOS.about.alt[lang]} sizes="100vw" eager />
    <div class="wrap">
      <span class="cap" style="color:var(--night-muted)">{t.about}</span>
      <h1>{t.aboutH}</h1>
      <p>{t.aboutP}</p>
    </div>
  </div>
  <section class="wrap sec" aria-labelledby="how-h">
    <div class="sec-h"><h2 id="how-h">{t.howH}</h2><p>{t.howP}</p></div>
    <div class="principles">
      {items.map((i, n) => (
        <div class="pr"><div class="vz" aria-hidden="true">{String(n + 1).padStart(2, '0')}</div><div class="tx"><h3>{i.h}</h3><p>{i.p}</p></div></div>
      ))}
    </div>
  </section>
  <div class="wrap sec" style="padding-top:0">
    <div class="tip"><h2>{t.tipH}</h2><a class="btn" href={localePath(lang, '/contact/')}><span>{t.contact}</span><span class="arr" aria-hidden="true">→</span></a></div>
  </div>
</BaseLayout>
