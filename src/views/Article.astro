---
import { render } from 'astro:content';
import { SITE, type Lang } from '../config/site';
import { UI, TOPIC_NAMES, TYPE_NAMES, localePath, formatDate } from '../i18n/ui';
import { getArticles, articleUrl, translationUrl, vizFor, readingMinutes, seedOf, splitId, type Article } from '../lib/articles';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import Viz from '../components/Viz.astro';
import Photo from '../components/Photo.astro';

interface Props { lang: Lang; entry: Article }
const { lang, entry } = Astro.props;
const t = UI[lang];
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const v = vizFor(entry);
const self = articleUrl(entry);
const other = await translationUrl(entry);
const otherLang: Lang = lang === 'en' ? 'ms' : 'en';
const alt = lang === 'en'
  ? { en: self, ms: other ?? localePath('ms', `/${d.topic}/`) }
  : { en: other ?? localePath('en', `/${d.topic}/`), ms: self };
const hreflang = other ? (lang === 'en' ? { en: self, ms: other } : { en: other, ms: self }) : undefined;
const all = await getArticles(lang);
const sameTopic = all.filter((a) => a.id !== entry.id && a.data.topic === d.topic);
const related = [...sameTopic, ...all.filter((a) => a.id !== entry.id && a.data.topic !== d.topic)].slice(0, 3);
const mins = readingMinutes(entry.body);
const topicName = TOPIC_NAMES[lang][d.topic];
if (d.faq.length > 0) toc.push({ slug: 'faq', text: t.faq });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': d.type === 'news' ? 'NewsArticle' : 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    inLanguage: lang,
    mainEntityOfPage: new URL(self, SITE.url).href,
    image: new URL(d.cover ?? SITE.defaultOg, SITE.url).href,
    articleSection: topicName,
    author: { '@type': 'Organization', name: 'rbnetwork', url: SITE.url },
    publisher: { '@type': 'Organization', name: 'rbnetwork', logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` } },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(localePath(lang, '/'), SITE.url).href },
      { '@type': 'ListItem', position: 2, name: topicName, item: new URL(localePath(lang, `/${d.topic}/`), SITE.url).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: new URL(self, SITE.url).href },
    ],
  },
  ...(d.faq.length > 0 ? [{
    '@context': 'https://schema.org', '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  }] : []),
];
---
<BaseLayout lang={lang} title={d.title} description={d.description} alt={alt} hreflang={hreflang} ogType="article" ogImage={d.cover} jsonLd={jsonLd}>
  <div class="progress" id="progress" aria-hidden="true"><i></i></div>
  <article>
    <div class="a-hero">{d.cover
      ? <><Photo src={d.cover} alt={d.coverAlt ?? ''} overlay={v.kind} seed={v.seed} eager />{d.coverCredit && <span class="tag cap">{t.photoBy}: {d.coverCredit}</span>}</>
      : <><Viz kind={v.kind} seed={v.seed} big /><span class="tag cap">{t.coverNote}</span></>}</div>
    <div class="wrap a-head">
      <header class="a-card">
        <nav class="crumbs" aria-label="Breadcrumb"><ol>
          <li><a href={localePath(lang, '/')}>{t.home}</a></li>
          <li><a href={localePath(lang, `/${d.topic}/`)}>{topicName}</a></li>
          <li><span>{TYPE_NAMES[lang][d.type]}</span></li>
        </ol></nav>
        <h1 class="a-title">{d.title}</h1>
        <p class="stand">{d.description}</p>
        <div class="byl">
          <span><span class="k">{t.by}</span>{t.team}</span>
          <span><span class="k">{t.published}</span><time datetime={d.pubDate.toISOString()}>{formatDate(lang, d.pubDate)}</time></span>
          {d.updatedDate && <span><span class="k">{t.updated}</span><time datetime={d.updatedDate.toISOString()}>{formatDate(lang, d.updatedDate)}</time></span>}
          <span><span class="k">{t.readTime}</span>{mins} min</span>
          {d.draft && <span class="flag">Draft</span>}
        </div>
        {other && <p class="trans"><a class="textlink" href={other} hreflang={otherLang} lang={otherLang}>{t.readOther} →</a></p>}
      </header>
    </div>
    <div class="wrap">
      <div class="a-lay">
        <nav class="toc" aria-label={t.onPage}>
          {toc.length > 0 && <><span class="cap">{t.onPage}</span><ol>{toc.map((h) => <li><a href={`#${h.slug}`}><span class="d" aria-hidden="true"></span><span>{h.text}</span></a></li>)}</ol></>}
        </nav>
        <div class="prose">
          {d.summary.length > 0 && (
            <aside class="short" aria-label={t.inShort}>
              <div class="vz"><Viz kind="terrain" seed={seedOf(splitId(entry.id).slug) + 9} /></div>
              <div class="tx"><h2>{t.inShort}</h2><ul>{d.summary.map((s) => <li>{s}</li>)}</ul></div>
            </aside>
          )}
          <Content />
          {d.faq.length > 0 && (
            <section class="faq" aria-labelledby="faq">
              <h2 id="faq">{t.faq}</h2>
              <div class="faq-list">
                {d.faq.map((f) => (
                  <details>
                    <summary>
                      <span class="q">{f.question}</span>
                      <svg class="chev" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7.5l5 5 5-5" /></svg>
                    </summary>
                    <p>{f.answer}</p>
                  </details>
                ))}
              </div>
            </section>
          )}
          {d.sources.length > 0 && (
            <div class="srcs"><span class="cap">{t.sources}</span><ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ol></div>
          )}
        </div>
        <aside class="rail" aria-label={`${t.alsoIn} ${topicName}`}>
          {sameTopic.length > 0 && <span class="cap">{t.alsoIn} {topicName}</span>}
          {sameTopic.slice(0, 2).map((a) => <StoryCard a={a} lang={lang} />)}
        </aside>
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="wrap sec" style="padding-top:0" aria-labelledby="keep-h">
      <div class="sec-h"><h2 id="keep-h">{t.keepReading}</h2></div>
      <div class="grid3">{related.map((a) => <StoryCard a={a} lang={lang} />)}</div>
    </section>
  )}
</BaseLayout>
