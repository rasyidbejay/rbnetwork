---
import { UI } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import Viz from '../components/Viz.astro';
const t = UI.en;
const m = UI.ms;
---
<BaseLayout lang="en" title="404" description={t.nfP} alt={{ en: '/', ms: '/ms/' }} noindex>
  <div class="nf">
    <Viz kind="lost" />
    <div class="lost" aria-hidden="true"><i></i><span>{t.here}</span></div>
    <div class="wrap">
      <div class="big" aria-hidden="true">404</div>
      <div class="card">
        <h1>{t.nfH}</h1>
        <p class="muted">{t.nfP}</p>
        <p class="muted" lang="ms">{m.nfH} {m.nfP}</p>
        <div class="cta-row"><a class="btn btn-ink" href="/"><span>{t.nfHome}</span><span class="arr" aria-hidden="true">→</span></a><a class="btn btn-line" href="/ms/" lang="ms">{m.nfHome}</a></div>
      </div>
    </div>
  </div>
</BaseLayout>
