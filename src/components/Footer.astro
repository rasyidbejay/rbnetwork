---
import { TOPICS, type Lang } from '../config/site';
import { UI, TOPIC_NAMES, localePath } from '../i18n/ui';
import Viz from './Viz.astro';
interface Props { lang: Lang; alt: { en: string; ms: string } }
const { lang, alt } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
---
<footer class="foot">
  <Viz kind="footer" />
  <div class="wrap">
    <div class="f-top">
      <p class="f-big">{t.footBig}</p>
      <div><h2>{t.topics}</h2><ul>{TOPICS.map((k) => <li><a href={localePath(lang, `/${k}/`)}>{TOPIC_NAMES[lang][k]}</a></li>)}</ul></div>
      <div><h2>rbnetwork</h2><ul><li><a href={localePath(lang, '/about/')}>{t.about}</a></li><li><a href={localePath(lang, '/contact/')}>{t.contact}</a></li><li><a href={localePath(lang, '/rss.xml')}>{t.rss}</a></li></ul></div>
      <div><h2>{t.language}</h2><ul><li><a href={alt.en} lang="en">English</a></li><li><a href={alt.ms} lang="ms">Bahasa Melayu</a></li><li><span lang="ar" style="font-size:14px;color:var(--night-muted)">العربية</span> <span style="font-size:14px;color:var(--night-muted)">{t.arabicLater}</span></li></ul></div>
    </div>
