---
import type { Lang } from '../config/site';
import { UI, TOPIC_NAMES } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const words = ['SEO', 'AEO', 'GEO', TOPIC_NAMES[lang]['web-development']];
---
<section class="band" id="band" aria-label={t.topics}>
  <div class="band-track">
    <div class="band-set">{words.map((w) => <><span>{w}</span><i aria-hidden="true"></i></>)}</div>
    <div class="band-set" aria-hidden="true">{words.map((w) => <><span>{w}</span><i></i></>)}</div>
  </div>
  <button class="band-pause" type="button" id="bandPause" aria-pressed="false" aria-label={t.pauseBand} data-pause={t.pauseBand} data-play={t.playBand}>
    <svg class="pa" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" rx="1"/><rect x="8.5" y="1" width="3.5" height="12" rx="1"/></svg>
    <svg class="pl" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z"/></svg>
  </button>
</section>
