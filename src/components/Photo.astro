---
/**
 * A photo with the site treatment (cool, quietly desaturated, dimmer in dark mode).
 * Fills its positioned parent.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata | string;
  alt: string;
  sizes?: string;
  eager?: boolean;
}
const { src, alt, sizes = '(min-width: 960px) 50vw, 100vw', eager = false } = Astro.props;
---
<div class="photo">
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} quality={72} />}
</div>
