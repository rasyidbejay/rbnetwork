---
/**
 * A photo with the site treatment (warm, desaturated, dimmer in dark mode)
 * and an optional thin line drawing on top, drawn by src/scripts/viz.ts.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Viz from './Viz.astro';
interface Props {
  src: ImageMetadata | string;
  alt: string;
  overlay?: 'terrain' | 'network' | 'grid' | 'team';
  seed?: number;
  sizes?: string;
  eager?: boolean;
}
const { src, alt, overlay, seed = 1, sizes = '(min-width: 960px) 50vw, 100vw', eager = false } = Astro.props;
---
<div class:list={['photo', { lined: !!overlay }]}>
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} quality={72} />}
  {overlay && <Viz kind={overlay} seed={seed} overlay />}
</div>
