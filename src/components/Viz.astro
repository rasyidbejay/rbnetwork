---
/** A generated picture. Drawn in the browser by src/scripts/viz.ts. */
interface Props {
  kind: 'terrain' | 'network' | 'roots' | 'grid' | 'team' | 'footer' | 'lost';
  overlay?: boolean;
  seed?: number;
  big?: boolean;
  night?: boolean;
  id?: string;
}
const { kind, seed = 1, big = false, night = false, overlay = false, id } = Astro.props;
---
<canvas class="viz" id={id} data-viz={kind} data-seed={seed} data-big={big ? '1' : undefined} data-night={night ? '1' : undefined} data-overlay={overlay ? '1' : undefined} aria-hidden="true"></canvas>
